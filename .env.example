# Service
ENV=development
PORT=4100
LOG_LEVEL=info

# Internal auth: Node API calls this service with a shared secret (not end-user JWT).
INTERNAL_API_KEY=change-me-long-random

# Same Postgres cluster as backend/ — Python owns schema "ai" only (see docs/SCHEMA_ARCHITECTURE.md).
DATABASE_URL=postgresql+psycopg://aazhi:aazhi@127.0.0.1:5433/aazhi
POSTGRES_SCHEMA=ai

# Artifacts (raw index blobs, snippets). Same Mongo as Node unless you split later.
MONGODB_URI=mongodb://127.0.0.1:27017/aazhi

# Optional: platform fallback when client keys are not passed per job
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Workspace for git clones (ephemeral)
REPO_WORKDIR=/tmp/aazhi-repos
